{
  "name": "sophias-wild-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "format": "prettier --write src tests *.ts *.json index.html .github/workflows/ci.yml",
    "format:check": "prettier --check src tests *.ts *.json index.html .github/workflows/ci.yml"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.20.4",
    "@types/three": "^0.180.0",
    "fake-indexeddb": "^6.2.0",
    "prettier": "^3.9.8",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
